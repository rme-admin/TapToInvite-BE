generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// --- ENUMS ---
enum Role {
  user
  admin
}

enum UserStatus {
  active
  unverified
  disabled
  archived
}

enum TicketStatus {
  open
  in_progress
  resolved
  closed
}

enum PaymentStatus {
  Pending
  Advance_Paid
  Fully_Paid
  Refunded
}

enum NfcTemplateStatus {
  active
  inactive
  archived
}

enum CardTemplateStatus {
  active
  inactive
  archived
}

enum CategoryStatus {
  active
  inactive
  archived
}

enum OrderStatus {
  Pending
  Team_Contacted
  Designing
  Printing
  Ready_to_be_shipped
  Shipped
  Delivered
}

enum ItemType {
  PLAN_BASE
  NFC
  NORMAL_CARD
  WEBSITE_BASIC
  WEBSITE_CUSTOM
  QR_CODE
  FRAME
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PlanStatus {
  active
  inactive
  archived
}

enum SubPlanStatus {
  active
  inactive
  archived
}

// --- TABLES ---

model ProductPlan {
  id                           Int               @id @default(autoincrement())
  name                         String
  description                  String            @db.Text
  base_price                   Decimal           @db.Decimal(10, 2)
  is_recommended               Boolean           @default(false)
  min_nfc_qty                  Int               @default(0)
  min_normal_qty               Int               @default(0)
  features                     Json
  icon_url                     String?
  status                       PlanStatus        @default(active)
  included_subscription_plan   SubscriptionPlan? @relation("PlanIncludedSub", fields: [included_subscription_plan_id], references: [id], onDelete: SetNull)
  included_subscription_plan_id Int?
  created_at                   DateTime          @default(now())
  updated_at                   DateTime          @updatedAt
  orders                       Order[]
}

model EventCategory {
  id                  Int                     @id @default(autoincrement())
  name                String
  slug                String                  @unique
  icon_url            String?
  status              CategoryStatus          @default(active)
  created_at          DateTime                @default(now())
  updated_at          DateTime                @updatedAt
  nfc_templates       NfcTemplateCategory[]
  normal_templates    NormalTemplateCategory[]
  orders              Order[]
}

model NfcTemplate {
  id                  Int                   @id @default(autoincrement())
  name                String
  description         String?               @db.Text
  width_mm            Decimal?              @db.Decimal(8, 2)
  height_mm           Decimal?              @db.Decimal(8, 2)
  images              Json
  price               Decimal               @db.Decimal(10, 2)
  status              NfcTemplateStatus     @default(active)
  is_recommended      Boolean               @default(false)
  created_at          DateTime              @default(now())
  updated_at          DateTime              @updatedAt
  categories          NfcTemplateCategory[]
}

model NfcTemplateCategory {
  nfc_template        NfcTemplate   @relation(fields: [nfc_template_id], references: [id])
  nfc_template_id     Int
  event_category      EventCategory @relation(fields: [event_category_id], references: [id])
  event_category_id   Int

  @@id([nfc_template_id, event_category_id])
}

model NormalCardTemplate {
  id                  Int                   @id @default(autoincrement())
  name                String
  description         String?               @db.Text
  width_mm            Decimal?              @db.Decimal(8, 2)
  height_mm           Decimal?              @db.Decimal(8, 2)
  images              Json
  price               Decimal               @db.Decimal(10, 2)
  status              CardTemplateStatus    @default(active)
  is_recommended      Boolean               @default(false)
  created_at          DateTime              @default(now())
  updated_at          DateTime              @updatedAt
  categories          NormalTemplateCategory[]
}

model NormalTemplateCategory {
  normal_template     NormalCardTemplate @relation(fields: [normal_template_id], references: [id])
  normal_template_id  Int
  event_category      EventCategory      @relation(fields: [event_category_id], references: [id])
  event_category_id   Int

  @@id([normal_template_id, event_category_id])
}

model User {
  id                  Int               @id @default(autoincrement())
  role                Role              @default(user)
  name                String
  email               String            @unique
  country_code        String            @default("+91")
  phone               String            @unique
  password_hash       String?
  status              UserStatus        @default(unverified)
  refresh_token       String?           @db.VarChar(500)
  verification_token  String?
  reset_token         String?           // Added for your 12h reset link
  reset_token_expiry  DateTime?
  reset_otp           String?           // 6-digit OTP for password reset
  reset_otp_expiry    DateTime?         // OTP expiry (15 minutes)
  created_at          DateTime          @default(now())
  
  details             UserDetails?
  orders              Order[]
  subscriptions       UserSubscription[]
  otps                Otp[]
  config_updates      SiteConfiguration[]
  tickets             Ticket[]           @relation("TicketUser")
  tickets_created     Ticket[]           @relation("TicketCreator")
  payments_marked     Payment[]          @relation("PaymentMarkedBy")
  assigned_subscriptions UserSubscription[] @relation("SubAssignedBy")
}

model Ticket {
  id                  Int           @id @default(autoincrement())
  ticket_number       String        @unique
  heading             String
  description         String?       @db.Text
  status              TicketStatus  @default(open)
  user                User          @relation("TicketUser", fields: [user_id], references: [id], onDelete: Cascade)
  user_id             Int
  created_by          User          @relation("TicketCreator", fields: [created_by_id], references: [id], onDelete: Cascade)
  created_by_id       Int
  updates             Json?         // Array of { date, heading, note, updatedBy }
  created_at          DateTime      @default(now())
  updated_at          DateTime      @updatedAt
}

model UserDetails {
  id                  Int      @id @default(autoincrement())
  user                User     @relation(fields: [user_id], references: [id])
  user_id             Int      @unique
  alt_phone           String?
  address_line_1      String
  address_line_2      String?
  city                String
  state               String
  pincode             String
  country             String   @default("India")
}

model Order {
  id                  Int           @id @default(autoincrement())
  order_number        String        @unique
  user                User          @relation(fields: [user_id], references: [id])
  user_id             Int
  plan                ProductPlan   @relation(fields: [plan_id], references: [id])
  plan_id             Int
  category            EventCategory @relation(fields: [event_category_id], references: [id])
  event_category_id   Int
  event_title         String
  event_date          DateTime
  digital_notes       String?       @db.Text
  total_amount        Decimal       @db.Decimal(10, 2)
  advance_paid        Decimal       @db.Decimal(10, 2)
  balance_amount      Decimal       @db.Decimal(10, 2)
  advance_payment_method String?
  balance_payment_method String?
  transaction_id      String?
  payment_status      PaymentStatus @default(Pending)
  order_status        OrderStatus   @default(Pending)
  created_at          DateTime      @default(now())
  updated_at          DateTime      @updatedAt

  items               OrderItem[]
  subscriptions       UserSubscription[]
  nfc_issuances       NFCCardIssuance[]
  tracking_notes      OrderTrackingNote[]
  payments            Payment[]
}

enum PaymentMode {
  online
  cash
  neft
  cheque
  upi
  other
}

model Payment {
  id                  Int           @id @default(autoincrement())
  order               Order         @relation(fields: [order_id], references: [id], onDelete: Cascade)
  order_id            Int
  transaction_id      String?       // payment reference / transaction ID
  amount              Decimal       @db.Decimal(10, 2)
  payment_note        String?       @db.Text
  status              PaymentStatus @default(Pending)
  mode                PaymentMode   @default(online)
  transaction_date    DateTime
  marked_by           User          @relation("PaymentMarkedBy", fields: [marked_by_id], references: [id])
  marked_by_id        Int
  created_at          DateTime      @default(now())
  updated_at          DateTime      @updatedAt
}

model OrderItem {
  id                  Int      @id @default(autoincrement())
  order               Order    @relation(fields: [order_id], references: [id])
  order_id            Int
  item_type           ItemType
  reference_id        Int?     // ID of the template/plan
  item_name           String
  quantity            Int
  unit_price          Decimal  @db.Decimal(10, 2)
  total_price         Decimal  @db.Decimal(10, 2)
}

model SubscriptionPlan {
  id                      Int                  @id @default(autoincrement())
  name                    String
  description             String?              @db.Text
  price                   Decimal              @db.Decimal(10, 2)
  duration_days           Int
  features                Json?                // JSON: { reminders: true, website: true, product_discounts: true, support: true, ... }
  default_reminder_config Json?
  status                  SubPlanStatus        @default(active)
  created_at              DateTime             @default(now())
  updated_at              DateTime             @updatedAt
  user_subscriptions      UserSubscription[]
  product_plans           ProductPlan[]        @relation("PlanIncludedSub")
  payments                SubscriptionPayment[]
  expired_records         ExpiredSubscription[]
}

model UserSubscription {
  id                   Int                @id @default(autoincrement())
  user                 User               @relation(fields: [user_id], references: [id])
  user_id              Int
  plan                 SubscriptionPlan   @relation(fields: [subscription_plan_id], references: [id])
  subscription_plan_id Int
  order                Order?             @relation(fields: [order_id], references: [id])
  order_id             Int?
  start_date           DateTime
  expiry_date          DateTime
  status               SubscriptionStatus @default(ACTIVE)
  reminder_config      Json?
  anniversary_date     DateTime?
  reminder_7d_sent     Boolean            @default(false)
  reminder_3d_sent     Boolean            @default(false)
  reminder_0d_sent     Boolean            @default(false)
  assigned_by_id       Int?               // Admin who manually assigned
  assigned_by          User?              @relation("SubAssignedBy", fields: [assigned_by_id], references: [id])
  created_at           DateTime           @default(now())
  updated_at           DateTime           @updatedAt
  payments             SubscriptionPayment[]
}

model ExpiredSubscription {
  id                   Int              @id @default(autoincrement())
  user_id              Int
  subscription_plan_id Int
  plan                 SubscriptionPlan @relation(fields: [subscription_plan_id], references: [id])
  plan_name            String
  start_date           DateTime
  expiry_date          DateTime
  duration_days        Int
  price_paid           Decimal          @db.Decimal(10, 2)
  order_id             Int?
  expired_at           DateTime         @default(now())
}

model SubscriptionPayment {
  id                   Int              @id @default(autoincrement())
  subscription         UserSubscription? @relation(fields: [subscription_id], references: [id], onDelete: SetNull)
  subscription_id      Int?
  plan                 SubscriptionPlan @relation(fields: [subscription_plan_id], references: [id])
  subscription_plan_id Int
  user_id              Int
  amount               Decimal          @db.Decimal(10, 2)
  transaction_id       String?          // Razorpay / manual reference
  mode                 PaymentMode      @default(online)
  payment_note         String?          @db.Text
  status               PaymentStatus    @default(Pending)
  transaction_date     DateTime
  marked_by_id         Int?             // Admin who recorded this
  created_at           DateTime         @default(now())
  updated_at           DateTime         @updatedAt
}

model PostPurchaseCategory {
  id                  Int                       @id @default(autoincrement())
  name                String
  slug                String                    @unique
  icon_url            String?
  parent              PostPurchaseCategory?     @relation("PPCatParent", fields: [parent_id], references: [id], onDelete: SetNull)
  parent_id           Int?
  children            PostPurchaseCategory[]    @relation("PPCatParent")
  status              CategoryStatus            @default(active)
  created_at          DateTime                  @default(now())
  updated_at          DateTime                  @updatedAt
  products            PostPurchaseProduct[]
}

model PostPurchaseProduct {
  id                  Int                       @id @default(autoincrement())
  name                String
  description         String?                   @db.Text
  images              Json?
  price               Decimal                   @db.Decimal(10, 2)
  discount_percent    Decimal?                  @db.Decimal(5, 2)
  stock_quantity      Int?
  status              CardTemplateStatus        @default(active)
  is_recommended      Boolean                   @default(false)
  category            PostPurchaseCategory?     @relation(fields: [category_id], references: [id], onDelete: SetNull)
  category_id         Int?
  created_at          DateTime                  @default(now())
  updated_at          DateTime                  @updatedAt
}

model SiteContent {
  id                  Int      @id @default(autoincrement())
  page_slug           String
  content_key         String
  title               String
  content             String   @db.LongText
  last_updated_by     Int
  updated_at          DateTime @updatedAt
}

model SiteConfiguration {
  id                  Int       @id @default(autoincrement())
  config_group        String
  config_key          String    @unique
  config_value        String    @db.Text
  description         String?
  updated_by_id       Int?
  updated_by          User?     @relation(fields: [updated_by_id], references: [id], onDelete: SetNull)
  updated_at          DateTime? @updatedAt
}

model NFCCardIssuance {
  id                      Int      @id @default(autoincrement())
  order                   Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  order_id                Int
  nfc_card_number         String   @unique
  autogenerated_key       String   @unique
  generated_url           String   @unique
  method                  String   @default("taptoinvite_site")
  calendar_url            String?  @db.Text
  calendar_enabled        Boolean  @default(true)
  location_url            String?  @db.Text
  location_enabled        Boolean  @default(true)
  digital_invitation_type String?
  digital_invitation_content String? @db.LongText
  digital_invitation_enabled Boolean @default(true)
  website_url             String?  @db.Text
  website_enabled         Boolean  @default(true)
  google_calendar_link    String?   @db.Text
  status                  String   @default("registered")
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt
  encoded_at              DateTime?
  shipped_at              DateTime?

  @@index([order_id])
  @@index([autogenerated_key])
}

model OrderTrackingNote {
  id            Int      @id @default(autoincrement())
  order         Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  order_id      Int
  note_date     DateTime
  note_time     String
  heading       String
  description   String   @db.LongText
  visible_to_user Boolean @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([order_id])
  @@index([visible_to_user])
}

model Otp {
  id                  Int      @id @default(autoincrement())
  user                User     @relation(fields: [user_id], references: [id])
  user_id             Int
  purpose             String
  valid_till          DateTime
  status              Boolean  @default(false) // 0 unused, 1 used
  code                String   // The actual 6 digit code
}